#!/usr/bin/env bash
# Ship the current issue worktree: refuse an unreviewed HEAD or a stale base, run
# the checks CI runs (inside the container, through bin/dexec), push, verify the
# push landed, and open a draft PR against the base that closes the issue.
# Adapted from ledewire/demo-buyer-site's bin/ship.
#
#   bin/ship --body-file <path>  ship the branch; <path> is the PR body written
#                                with /mattpocock-skills:pr (Closes #<n> is prepended)
#   bin/ship --reviewed          record that /mattpocock-skills:code-review and
#                                /security-review both ran against the current HEAD
#   bin/ship                     re-run after new commits, once a PR is open
#
# The issue number and base come from the worktree's .env (ISSUE_NUMBER,
# BASE_BRANCH), which `bin/worktree issue <n>` writes. The base is `main` unless
# the issue named another one in its Base branch section.
#
# The review stamp catches forgetting, not dishonesty: `--reviewed` can be run
# without reviewing. SHIP_SKIP_REVIEW=1 ships without one. SHIP_SKIP_CHANGESET=1
# skips the local changeset check, for a PR that will carry the skip-changeset
# label (docs-only, CI-only).
set -euo pipefail

die() { echo "bin/ship: $*" >&2; exit 1; }
step() { echo "== $1 =="; }

# Dies with $1 when tracked files have uncommitted changes. Untracked scratch
# files are not part of what gets pushed, so they do not count.
require_committed() {
  [ -n "$(git status --porcelain --untracked-files=no)" ] || return 0
  git status --short --untracked-files=no >&2
  die "$1"
}

skipped() {
  case "${1:-}" in ''|0|no|false) return 1 ;; *) return 0 ;; esac
}

mode="ship"
body_file=""
case "${1:-}" in
  --reviewed) mode="reviewed" ;;
  --body-file)
    body_file="${2:-}"
    [ -n "$body_file" ] || die "--body-file needs a path."
    [ -s "$body_file" ] || die "PR body file '$body_file' is missing or empty."
    body_file="$(cd "$(dirname "$body_file")" && pwd)/$(basename "$body_file")" ;;
  "") ;;
  -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) die "unrecognized argument: $1 (try --help)" ;;
esac

cd "$(dirname "$0")/.."

branch="$(git branch --show-current)"
[ -n "$branch" ] || die "not on a branch (detached HEAD) — nothing to ship."
case "$branch" in
  main|feature/*|changeset-release/*)
    die "on $branch. Issue work happens on a branch from 'bin/worktree issue <n>' — see /issue." ;;
esac

# Read only the two keys this script needs, rather than sourcing the whole file.
env_value() {
  [ -f .env ] || return 0
  sed -n "s/^$1=//p" .env | tail -n 1
}

issue="$(env_value ISSUE_NUMBER)"
case "$issue" in
  ''|*[!0-9]*)
    die "this worktree has no ISSUE_NUMBER in .env, so there is no issue to close. Every
change ships against an issue: file one, then create the worktree with
'bin/worktree issue <n>'." ;;
esac
case "$branch" in
  "$issue"-*) ;;
  *) die "branch '$branch' does not belong to issue #$issue (ISSUE_NUMBER in .env).
Ship from the worktree 'bin/worktree issue $issue' created." ;;
esac

base="$(env_value BASE_BRANCH)"
base="${base:-main}"
reviews_dir="$(git rev-parse --absolute-git-dir)/ship-reviews"
head_sha="$(git rev-parse HEAD)"

if [ "$mode" = "reviewed" ]; then
  require_committed "uncommitted changes to tracked files, so a stamp for HEAD would not
describe what gets pushed. Commit them, then re-run."
  mkdir -p "$reviews_dir"
  touch "$reviews_dir/$head_sha"
  echo "Recorded: both reviews ran against $(git rev-parse --short HEAD)."
  exit 0
fi

step "Fetching $base"
git fetch --quiet origin "$base"

[ -n "$(git log "origin/$base..HEAD" --oneline)" ] \
  || die "$branch has no commits ahead of origin/$base — nothing to ship."

behind="$(git rev-list --count "HEAD..origin/$base")"
if [ "$behind" -gt 0 ]; then
  die "$branch is $behind commit(s) behind origin/$base, so CI would test a stale merge.
Refresh first with 'bin/worktree sync', then re-run."
fi

require_committed "uncommitted changes to tracked files would not be pushed. Commit or stash them."

if skipped "${SHIP_SKIP_REVIEW:-}"; then
  step "Skipping the review gate (SHIP_SKIP_REVIEW=$SHIP_SKIP_REVIEW)"
elif [ ! -f "$reviews_dir/$head_sha" ]; then
  {
    echo "bin/ship: HEAD ($(git rev-parse --short HEAD)) has not been reviewed. Run both, then record them:"
    echo
    echo "  /mattpocock-skills:code-review"
    echo "  /security-review"
    echo "  bin/ship --reviewed"
    prior="$(ls -t "$reviews_dir" 2>/dev/null | head -n 1 || true)"
    if [ -n "$prior" ] && git merge-base --is-ancestor "$prior" HEAD 2>/dev/null; then
      echo
      echo "$(git rev-parse --short "$prior") was reviewed; these landed since:"
      git log "$prior..HEAD" --format='  %h %s'
      echo "A mechanical fix needs only a fresh stamp; anything more needs a fresh review."
    fi
  } >&2
  exit 1
fi

repo_slug="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
pr_url="$(gh pr list --head "$branch" --state open --json url --jq '.[0].url')"
if [ -z "$pr_url" ] && [ -z "$body_file" ]; then
  die "no PR is open for $branch yet, so it needs a body. Write one with
/mattpocock-skills:pr to a scratch file (not the repo), then:

  bin/ship --body-file <path>"
fi

# The same steps, in the same order, as .github/workflows/ci.yml. Each runs in
# this worktree's container; a failure stops the script (set -e) with the
# command's own output above it.
step "Running the CI checks in the container"
bin/dexec pnpm install --frozen-lockfile --prefer-offline
bin/dexec pnpm format:check
bin/dexec pnpm typecheck
bin/dexec pnpm lint
bin/dexec pnpm build
bin/dexec pnpm test:coverage
bin/dexec pnpm audit --audit-level=high
bin/dexec pnpm publint packages/node
bin/dexec pnpm publint packages/browser

step "Checking generated files are committed"
bin/dexec pnpm generate:types
git diff --exit-code packages/core/src/api.gen.ts \
  || die "packages/core/src/api.gen.ts is out of date with ledewire.yml. Commit the regenerated file."
bin/dexec pnpm run docs
structural="$(git status --porcelain --untracked-files=all docs/api | grep -E '^(\?\?|D | D)' || true)"
[ -z "$structural" ] || die "docs/api has added or removed pages. Commit the output of 'bin/dexec pnpm run docs':
$structural"
# What is left is content-only churn (navigation.js/search.js differ across Node
# versions; CI ignores it too). Safe to discard: require_committed above proved
# docs/api had no uncommitted changes before the regeneration.
git checkout --quiet -- docs/api

if skipped "${SHIP_SKIP_CHANGESET:-}"; then
  step "Skipping the changeset check (SHIP_SKIP_CHANGESET=$SHIP_SKIP_CHANGESET); label the PR skip-changeset"
else
  step "Checking for a changeset against $base"
  bin/dexec pnpm changeset status --since="origin/$base" \
    || die "no changeset since origin/$base. Add one under .changeset/ (see /issue), or for a
docs-only or CI-only change re-run with SHIP_SKIP_CHANGESET=1 and label the PR skip-changeset."
fi

require_committed "the checks changed tracked files (a formatter or generator ran). Commit the
result, run the reviews' stamp again ('bin/ship --reviewed'), then re-run."

if [ -n "${GH_TOKEN:-}" ]; then
  push_remote="https://x-access-token:${GH_TOKEN}@github.com/${repo_slug}.git"
else
  push_remote="origin"
fi

step "Pushing $branch"
git push "$push_remote" "$head_sha:refs/heads/$branch" 2>&1 | sed "s/${GH_TOKEN:-__no_token__}/***/g"

step "Verifying $branch landed on GitHub"
remote_sha="$(git ls-remote "$push_remote" "refs/heads/$branch" 2>/dev/null | awk 'NR==1 {print $1}')"
[ "$remote_sha" = "$head_sha" ] \
  || die "push reported success, but refs/heads/$branch on GitHub is at ${remote_sha:-nothing}, not $head_sha."

step "Opening a draft PR against $base"
if [ -n "$pr_url" ]; then
  echo "PR already open — not creating a duplicate."
  [ -z "$body_file" ] || echo "Its body was left alone; update it with: gh pr edit $branch --body-file <path>"
else
  pr_body="Closes #$issue

$(grep -Eiv "^(closes|fixes|resolves) #$issue\$" "$body_file" || true)"
  pr_url="$(gh pr create --base "$base" --head "$branch" --draft --fill --body "$pr_body")"
fi

echo
echo "pr: $pr_url"
echo "sha: $head_sha"
echo "Wait for CI, then mark ready:  gh pr checks $branch --watch && gh pr ready $branch"
